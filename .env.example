# Copy to .env.local and fill in. None are required to build or run the site.

# Public site URL, used for canonical URLs, OG images, sitemap and JSON-LD.
# Set this to the real domain in production; the fallback below is only a
# sensible default for preview deployments.
NEXT_PUBLIC_SITE_URL=https://devvault-three.vercel.app

# Resend (contact form email). Without RESEND_API_KEY the form still validates
# input, but it tells the sender it cannot deliver and offers a mailto: link,
# rather than claiming the message was sent.
RESEND_API_KEY=
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=tarikfilipovic1234@gmail.com
# Sender. Until a custom domain is verified in Resend, the onboarding sender
# (the default) works and delivers to the account owner's address.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Set to 1 once real project screenshots exist at public/projects/<slug>.png.
# Until then project cards render without an image slot.
NEXT_PUBLIC_HAS_SCREENSHOTS=
